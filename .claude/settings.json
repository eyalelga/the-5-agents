{
  "permissions": {
    "allow": [
      "Bash(git push *)",
      "Bash(git commit -m ' *)",
      "Bash(npx nano-banana-mcp *)",
      "Read(//c/Users/User/.claude/**)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)"
    ]
  },
  "mcpServers": {
    "nano-banana-2": {
      "command": "npx",
      "args": ["nano-banana-mcp"],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      }
    }
  }
}
